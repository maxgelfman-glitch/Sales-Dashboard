# ============================================================================
# Live (paper by default) environment template. Copy to a private file, fill the
# secrets, `set -a; source <file>; set +a`, then:
#     python main_supervisor.py --check-config      # prints the report, connects to nothing
#     python main_supervisor.py                     # starts the engine
# NEVER commit a filled-in copy (tokens, keys).
# ============================================================================

# --- mode ------------------------------------------------------------------
TRADING_MODE=paper                     # paper | live
LIVE_TRADING_ACKNOWLEDGED=             # must be "yes" for TRADING_MODE=live
NOVIG_BEARER_TOKEN=                    # secret

# --- Novig -----------------------------------------------------------------
# One socket carries prices AND our executions (channels "tape" + "orders").
# Live default: wss://api.novig.com/tape   (QA: wss://api-qa.novig.us/tape)
NOVIG_WS_URL=
NOVIG_API_BASE=https://api.novig.us    # REST: /nbx/v2/emm/events bootstrap + /v1/orders
NOVIG_FILL_VOLUME_MODE=cumulative      # filled_volume is a running total per order id
# NOVIG_SUBSCRIBE_MESSAGES=[{"event":"subscribe","channel":"tape"},{"event":"subscribe","channel":"orders"}]

# --- settlement / restart sync (live) ----------------------------------------
# NOVIG_POSITIONS_PATH=/v1/positions
# NOVIG_POSITIONS_STATUS_PARAM=status
# NOVIG_OPEN_STATUS=OPEN
# NOVIG_SETTLED_STATUS=SETTLED
# SETTLEMENT_SWEEP_SECONDS=900

# --- guarded rollout (live) -------------------------------------------------
# Canary defaults: $10 stake, $100 exposure, maker off. Raising ANY of them requires
# LIVE_SCALE_APPROVED_BY (logged CRITICAL and written to live_ledger.jsonl).
LIVE_MAX_STAKE_USD=10
LIVE_EXPOSURE_LIMIT_USD=100
MAKER_MODE=false
LIVE_SCALE_APPROVED_BY=                # e.g. "Jane Doe 2026-10-01, ledger reconciled vs Novig history"

# --- sharp odds (fair value) --------------------------------------------------
# Leave BOTH unset for MEASUREMENT mode: venue prices, cross-venue gaps and liquidity are recorded,
# nothing that needs a fair value trades.
# Option A: TheRundown v2 (Ultra plan or above for the real-time WebSocket)
SHARP_PROVIDER=                        # "therundown" to use it
THERUNDOWN_API_KEY=                    # secret
THERUNDOWN_AFFILIATE_IDS=3             # books to read: 3 = Pinnacle (add others comma-separated)
THERUNDOWN_WEBSOCKET=1                 # 0 = REST polling only (lower plans)
# Option B: a JSON-mapped provider (OpticOdds / OddsJam examples in config/)
SHARP_PROVIDER_CONFIG=                 # e.g. config/sharp_provider.json
SHARP_API_KEY=                         # secret
# Fair value
DEVIG_METHOD=multiplicative            # multiplicative | power | shin
SHARP_BOOK_WEIGHTS=                    # consensus across books, e.g. pinnacle:2,circa sports:1 (empty = equal)
# Taker filters (leave off until research_report.py shows they help)
TAKER_REQUIRE_SHARP_MOVED_LAST=0       # 1 = only take edges where the sharp moved after the venue
TAKER_MAX_SHARP_MOVE_AGE_SECONDS=      # e.g. 5 = and only within 5s of that move

# --- Kalshi (data-only in live mode) ----------------------------------------
KALSHI_ENABLED=0
KALSHI_ENV=demo                        # demo | prod (prod host: api.elections.kalshi.com)
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=               # path to the .pem, outside the repo
KALSHI_LIVE_TRADING=0                  # 1 = real Kalshi orders (live mode only; same canary limits as Novig)
KALSHI_TIME_IN_FORCE=immediate_or_cancel   # taker orders never rest on Kalshi

# --- pregame cutoff & research ---------------------------------------------
NOVIG_MULTI_LEVEL_MODE=staggered       # staggered (one order per price level) | single | off
TAKER_CUTOFF_MINUTES=1                 # no new orders/hedges this long before the scheduled start
MAKER_CUTOFF_MINUTES=3                 # resting quotes pulled this long before (>= taker cutoff)
CUTOFF_OVERRIDES=                      # per league taker/maker minutes, e.g. NBA=1/3,NFL=1/3
RESEARCH_ENABLED=1                     # measurement rows for research_report.py (no exchange effect)
RESEARCH_DIR=research

ARB_PAIRS_ENABLED=1                    # buy both sides when they lock a profit after fees (no sharp needed)

# --- paper execution realism -------------------------------------------------------
PAPER_EXECUTION=simulated              # simulated (delay + depth haircut, live order path) | instant (optimistic)
SIM_LATENCY_MS=500                     # how long after sending the order the book is checked
SIM_DEPTH_HAIRCUT=0.5                  # share of the remaining displayed depth we get

# --- risk controls -------------------------------------------------------------
GAME_EXPOSURE_LIMIT_USD=1000           # unhedged $ per game across its moneyline/spread/total
DAILY_LOSS_LIMIT_USD=2000              # settled loss per UTC day that stops new risk ("off" to disable)
ALERT_WEBHOOK_URL=                     # CRITICAL events -> Slack/Discord webhook or https://ntfy.sh/<topic>

# --- ProphetX (price feed for paper trading + research; never traded live yet) ----
PROPHETX_ENABLED=0
PROPHETX_ACCESS_KEY=                   # secret (ProphetX partner API keys)
PROPHETX_SECRET_KEY=                   # secret
# PROPHETX_API_BASE=https://cash.api.prophetx.co/partner   (sandbox: https://api.sandbox.prophetx.dev/partner)

TRADING_LOG_DIR=logs                   # trading_engine.log + live_ledger.jsonl
